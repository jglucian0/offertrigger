// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           Int               @id @default(autoincrement())
  name         String?
  imageUrl     String
  originalUrl  String
  affiliateUrl String
  createdAt    DateTime          @default(now())
  
  // Relação muitos-para-muitos com Nichos
  niches       NicheAssignment[]
}

model Niche {
  id       Int               @id @default(autoincrement())
  name     String            @unique // academia, eletronicos, moda
  
  products NicheAssignment[]
}

model NicheAssignment {
  productId Int
  nicheId   Int
  product   Product @relation(fields: [productId], references: [id])
  niche     Niche   @relation(fields: [nicheId], references: [id])

  @@id([productId, nicheId])
}